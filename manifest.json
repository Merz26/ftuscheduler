{
  "manifest_version": 3,
  "key": "",
  "name": "FTU Schedule Sync",
  "version": "1.4.1",
  "description": "Synchronize university class schedules with Google Calendar.",
  "icons": {
    "16": "extension/ftu_logo.png",
    "48": "extension/ftu_logo.png",
    "128": "extension/ftu_logo.png"
  },
  "action": {
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "extension/ftu_logo.png",
      "48": "extension/ftu_logo.png",
      "128": "extension/ftu_logo.png"
    }
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "alarms",
    "storage",
    "notifications",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "*://qldt.hcmc.ftu.edu.vn/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "1068393903577-5g3l76neofv7fgdtkshfpcqcf9rprh1n.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "web_accessible_resources": []
}
